
enum 50101 "PFE Scheme Status"
{
    Extensible = true;

    value(0; Draft)
    {
        Caption = 'Draft';
    }

    value(1; Active)
    {
        Caption = 'Active';
    }

    value(2; Suspended)
    {
        Caption = 'Suspended';
    }

    value(3; Closed)
    {
        Caption = 'Closed';
    }
}
